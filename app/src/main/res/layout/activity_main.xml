<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101922"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/icon_mountain"
            android:layout_width="28dp"
            android:layout_height="20dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/icon_mountain"
            android:src="@drawable/ic_mountain" />

        <TextView
            android:id="@+id/altitude_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="#FFFFFF"
            android:textSize="64sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/altitude_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#B3C5D7"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#7F8FA0"
            android:textSize="11sp"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
